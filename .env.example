# Copy to backend/.env and fill in real values. Do not commit backend/.env.

# Gemini API key from https://aistudio.google.com/app/apikey
# Used by /diagnose, Identifier, Director, and Coach (Live).
GOOGLE_API_KEY=

# YouTube Data API v3 key from Google Cloud Console.
# Used by the YouTube fallback path when a cached MP4 is unavailable.
YOUTUBE_API_KEY=

# Optional overrides
# LIVE_MODEL=gemini-3.1-flash-live-preview
# LIVE_ENABLED=true

# Required only if you wire up Veo 3 video generation via Vertex AI:
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1
# GCS_BUCKET=
